# LLM & API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODE=gemini # gemini | mock_adversarial | fallback_only

# PayPal Sandbox v2 Configuration
PAYMENT_MODE=paypal_sandbox # paypal_sandbox | mock
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_ENV=SANDBOX

# Security & Currency Constants
HMAC_SECRET_KEY=super-secret-demo-hmac-key-2026
USD_TO_INR_PAISE=8400

# Hardware Serial Configuration
ESP32_SERIAL_PORT= # e.g., /dev/ttyUSB0 or COM4 (leave empty for virtual twin)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
